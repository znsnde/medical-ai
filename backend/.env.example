# MySQL配置
DB_URL=mysql+pymysql://root:123456@127.0.0.1:3306/medical_db?charset=utf8mb4
# 大模型API
LLM_API_KEY=sk-你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
# HuggingFace 镜像（国内直连 huggingface.co 超时，建议走 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com
# 文件存储
UPLOAD_PATH=./static/upload
# Milvus向量库
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# Neo4j图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=你的neo4j密码
# 服务端口
SERVER_PORT=8000
# JWT签名密钥（独立随机值，用 openssl rand -hex 32 生成，勿复用 LLM_API_KEY）
JWT_SECRET=这里填随机生成的64位hex
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
