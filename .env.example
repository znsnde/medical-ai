# docker-compose.yml 插值变量模板 —— 复制为 .env 后按需修改
# docker compose 会自动读取同目录的 .env

# 国内镜像前缀（避免 Docker Hub 拉取慢/超时）
# 示例：REGISTRY=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/
# 留空则使用 Docker Hub 官方镜像（mysql/neo4j/python/node/nginx 等）
REGISTRY=

# 数据存储口令（需与 backend/.env 中对应值一致）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=medical_db
NEO4J_PASS=12345678

# 对外端口（后端前端各一个；数据存储不对外映射，避免与本机已跑服务冲突）
BACKEND_PORT=8000
FRONTEND_PORT=80
